{
  "remarks": "🇳🇱 Нидерланды",
  "inbounds": [
    {"listen": "127.0.0.1", "port": 10808, "protocol": "socks", "tag": "socks"}
  ],
  "outbounds": [
    {
      "protocol": "vless",
      "tag": "proxy",
      "settings": {"vnext": [{"address": "srv1.example.net", "port": 443,
                              "users": [{"id": "00000000-0000-0000-0000-000000000000", "encryption": "none"}]}]},
      "streamSettings": {"network": "xhttp", "security": "tls",
                         "tlsSettings": {"serverName": "srv1.example.net", "fingerprint": "firefox"}}
    },
    {
      "protocol": "vless",
      "tag": "proxy-2",
      "settings": {"vnext": [{"address": "srv2.example.net", "port": 443,
                              "users": [{"id": "00000000-0000-0000-0000-000000000000", "encryption": "none"}]}]},
      "streamSettings": {"network": "tcp", "security": "reality",
                         "realitySettings": {"serverName": "www.example.com", "fingerprint": "chrome"}}
    },
    {"protocol": "freedom", "tag": "DIRECT"},
    {"protocol": "blackhole", "tag": "BLOCK"}
  ],
  "routing": {
    "balancers": [{"tag": "AUTO", "selector": ["proxy"], "fallbackTag": "DIRECT", "strategy": {"type": "leastLoad"}}],
    "rules": [
      {"domain": ["geosite:category-ru", "geosite:private"], "outboundTag": "DIRECT"},
      {"ip": ["geoip:private", "geoip:direct"], "outboundTag": "DIRECT"},
      {"network": "tcp,udp", "balancerTag": "AUTO"}
    ]
  }
}
