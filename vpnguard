def panel_main(s, w, h):
    r = s["r"]
    state = r["state"] if r else None
    color = STATE_COLOR.get(state, MUTED)
    label = LABELS_SHORT.get(state, "проверяю…")
    exits = s["exit"]
    route_text = f"{exits[0] or '?'} → {exits[1] or '?'}" if exits else "…"
    conf = s["conf"] or {}
    srv = (r or {}).get("tag") or "?"
    status = fit([f"{BOLD}{color}● {label}{RESET}",
                  f"{MUTED}туннель{RESET} {c256(78) + 'вкл' if r and r['vpn'] else c256(203) + 'выкл'}{RESET}",
                  f"{MUTED}выход{RESET} {route_text}",
                  f"{MUTED}сервер{RESET} {tag_color(srv)}{srv}{RESET}" + (f" {MUTED}·{RESET} {conf['remarks']}" if conf.get("remarks") else ""),
                  f"{MUTED}сторож{RESET} {c256(78) + '●' if s['watcher'] else c256(203) + '○'}{RESET}"], w - 4)
    if state and state != "OK":
        status = fit([status, f"{color}{LABELS[state]}{RESET}"], w - 4)

    side = max(min(w // 3, 40), 28)
    gw_ = w - 4 - side - 3
    hist = s["hist"]
    plot = graph(hist["proxy"], gw_, h - 4, log_scale=True)
    ok = [v for v in hist["proxy"] if v is not None]
    scale = f"{MUTED}макс {short_ms(max(ok)) if ok else '—'}  среднее {short_ms(statistics.mean(ok)) if ok else '—'}{RESET}"

    score, jit = quality(s["states"], hist["proxy"]), jitter(hist["proxy"])
    loss = loss_pct(hist["proxy"][-40:])
    wifi = s["wifi"] or {}
    sig = wifi.get("signal")
    bw = side - 22

    def meter(name, value, frac, color=None):
        return f"{MUTED}{name:<10}{RESET}{value:>9} {bar(frac, bw, color)}"

    last = lambda k: hist[k][-1] if hist[k] else None
    rows = [
        meter("Качество", f"{score}/100" if score is not None else "…", (score or 0) / 100,
              paint_level(100 - (score or 100), 15, 40)),
        meter("Через VPN", short_ms(last("proxy")), min((last("proxy") or 0) / 1500, 1)),
        meter("Роутер", short_ms(last("gw")), min((last("gw") or 0) / 100, 1)),
        meter("Интернет", short_ms(last("direct")), min((last("direct") or 0) / 300, 1)),
        meter("Джиттер", short_ms(jit), min((jit or 0) / 300, 1)),
        meter("Потери", f"{loss:.0f}%", loss / 20),
        meter("Wi-Fi", f"{sig} дБм" if sig else "…", (sig + 90) / 60 if sig else 0,
              paint_level(-sig, 67, 75) if sig else None),
    ]
    if wifi.get("channel"):
        rows.append(f"{MUTED}{'Канал':<10}{RESET}{wifi['channel']:>9}")
    sep = f"{FRAME['main']}│{RESET}"
    body = [status, ""]
    for i in range(h - 4):
        left = plot[i] if i < len(plot) else ""
        if i == h - 5:
            left = scale
        body.append(pad(left, gw_) + f" {sep} " + (rows[i] if i < len(rows) else ""))
    return box("Задержка через VPN", body, w, FRAME["main"], h, time.strftime("%H:%M:%S"))


def panel_net(s, w, h):
    down, up = s["net"]
    content = h - 2
    gd = max((content - 3) // 2 + (content - 3) % 2, 1)
    gu = max(content - 3 - gd, 0)
    top = max(max(down[-(w * 2):], default=0), max(up[-(w * 2):], default=0), 1) * 1.1
