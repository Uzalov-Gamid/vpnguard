#!/opt/homebrew/bin/python3 -I
"""vpnguard: сторож для Happ на macOS.

Каждые несколько секунд проверяет связь по уровням: Wi-Fi/роутер, прямой
интернет, туннель, реальный трафик через прокси. Туннель перезапускается только
если сломан именно он, поэтому плохой Wi-Fi не вызывает лишних перезапусков.
"""
import argparse, collections, concurrent.futures as cf, json, math, os, plistlib, re, shutil, signal
import select, statistics, subprocess, sys, termios, textwrap, threading, time, tty
from pathlib import Path

HOME = Path.home()
LOG = HOME / "Library/Logs/vpnguard.jsonl"
BIN = HOME / ".local/bin/vpnguard"
ALIAS = HOME / ".local/bin/vpn"
AGENT = HOME / "Library/LaunchAgents/com.vpnguard.plist"
CONF = HOME / ".config/vpnguard/happ.json"
IP_CACHE = HOME / ".cache/vpnguard/ip.json"
HAPP_PREFS = HOME / "Library/Group Containers/group.su.ffg.happ.ruplus2/Library/Preferences/group.su.ffg.happ.ruplus2.plist"
ACCESS_LOG = HAPP_PREFS.parents[1] / "Application Support/Xray/logs/access.log"
SPEED_DOWN = "https://speed.cloudflare.com/__down?bytes=25000000"
SPEED_UP = "https://speed.cloudflare.com/__up"
PROBE_URL = "https://www.gstatic.com/generate_204"
TRACE_URL = "https://1.1.1.1/cdn-cgi/trace"
DIRECT_HOST = "77.88.8.8"
GW_SLOW_MS = 500
# Эталон раздельной маршрутизации: российские сайты должны идти напрямую, остальные через VPN
SITES = [("ya.ru", "RU"), ("vk.com", "RU"), ("www.gosuslugi.ru", "RU"), ("www.ozon.ru", "RU"),
         ("www.sberbank.ru", "RU"), ("www.youtube.com", "VPN"), ("github.com", "VPN"),
         ("chatgpt.com", "VPN"), ("www.instagram.com", "VPN"), ("web.telegram.org", "VPN")]
RU_HINTS = ("yandex.ru", "yandex.net", "yastatic", "vk.com", "vk.me", "userapi.com", "mail.ru", "ok.ru",
            "avito", "ozon", "wildberries", "wb.ru", "gosuslugi", "sber", "tbank", "tinkoff", "kinopoisk",
            "dzen", "rutube", "mos.ru")
NOISE = {"www.gstatic.com", "1.1.1.1", "8.8.8.8", "speed.cloudflare.com"}  # собственные проверки vpnguard
SERVICE_TAGS = {"DIRECT", "BLOCK", "dns-out"}

LABELS = {
    "OK": "всё работает",
    "LOCAL": "сбой Wi-Fi/роутера, VPN не виноват",
    "ISP": "роутер отвечает, но нет прямого интернета",
    "VPN_BROKEN": "сеть в порядке, но через VPN трафик не идёт",
    "LEAK": "серверы VPN недоступны, Happ пустил трафик напрямую",
    "VPN_DOWN": "туннель Happ выключен",
}
LABELS_SHORT = dict(OK="Норма", LOCAL="Wi-Fi", ISP="Провайдер", VPN_BROKEN="Сбой VPN", LEAK="Обход VPN",
                    VPN_DOWN="Выключен")
BROKEN = ("VPN_BROKEN", "LEAK")


def run(cmd, timeout):
    try:
        return subprocess.run(cmd, capture_output=True, text=True, timeout=timeout)
    except subprocess.TimeoutExpired:
        return None


def route():
    """Шлюз и интерфейс физической сети; default через utun пропускается."""
    out = run(["netstat", "-rn", "-f", "inet"], 5)
    for line in (out.stdout if out else "").splitlines():
        p = line.split()
        if len(p) >= 4 and p[0] == "default" and re.fullmatch(r"[\d.]+", p[1]):
            return p[1], p[3]
    return None, None


def ping_once(host, iface=None, timeout=2):
    cmd = ["ping", "-c", "1", "-t", str(timeout)] + (["-b", iface] if iface else []) + [host]
    out = run(cmd, timeout + 1)
    m = re.search(r"time=([\d.]+)", out.stdout) if out else None
    return float(m.group(1)) if m else None


def service():
    out = run(["scutil", "--nc", "list"], 5)
    for line in (out.stdout if out else "").splitlines():
        if "su.ffg.happ" in line:
            m = re.search(r"\(([^)]+)\)\s+([0-9A-F-]{36})", line)
            if m:
                return m.group(2), m.group(1)
    return None, None


def socks_port():
    try:
        return plistlib.loads(HAPP_PREFS.read_bytes()).get("sockstProxyPort") or "10808"
    except (OSError, plistlib.InvalidFileException):
        return "10808"


def access_tail(size):
    try:
        with ACCESS_LOG.open("rb") as f:
            f.seek(max(ACCESS_LOG.stat().st_size - size, 0))
            return f.read().decode(errors="ignore")
    except OSError:
        return ""


def outbound_of(lport, size=40_000):
    """Какой outbound Happ выбрал для нашего запроса: строку журнала находим по локальному порту curl."""
    for _ in range(3):
        m = re.search(rf"from tcp:127\.0\.0\.1:{lport} accepted \S+ \[\S+ (?:->|>>) ([\w-]+)\]", access_tail(size))
        if m:
            return m.group(1)
        time.sleep(0.2)
    return None


def via_proxy(port, url, timeout):
    """Запрос через SOCKS Happ: (код, мс, локальный порт) или None."""
    cmd = ["curl", "-sk", "-o", "/dev/null", "-m", str(timeout), "-x", f"socks5h://127.0.0.1:{port}",
           "-w", "%{http_code} %{time_total} %{local_port}", url]
    out = run(cmd, timeout + 1)
    p = out.stdout.split() if out else []
    return (p[0], float(p[1]) * 1000, p[2]) if len(p) == 3 else None


def proxy_ms(port, timeout=6):
    """Задержка через VPN и сервер, который её обслужил. DIRECT значит обход туннеля."""
    r = via_proxy(port, PROBE_URL, timeout)
    if not r or r[0] != "204":
        return None, None
    return r[1], outbound_of(r[2])


def location(args):
    out = run(["curl", "-s", "-m", "6", *args, TRACE_URL], 7)
    m = re.search(r"^loc=(\w+)", out.stdout, re.M) if out else None
    return m.group(1) if m else None


def classify(vpn_up, gw, direct, proxy, tag=None):
    """Уровень сбоя; снизу вверх, потому что верхний уровень зависит от нижнего."""
    if gw is None or gw > GW_SLOW_MS:
        return "LOCAL"
    if direct is None:
        return "ISP"
    if not vpn_up:
        return "VPN_DOWN"
    if proxy is None:
        return "VPN_BROKEN"
    # балансировщик Happ при падении всех серверов уходит в fallbackTag DIRECT: проверка проходит, но мимо VPN
    return "LEAK" if tag == "DIRECT" else "OK"


def sample(port):
    gw_ip, iface = route()
    sid, st = service()
    with cf.ThreadPoolExecutor(3) as ex:
        gw = ex.submit(ping_once, gw_ip, iface) if gw_ip else None
        direct = ex.submit(ping_once, DIRECT_HOST, iface, 3) if iface else None
        proxy = ex.submit(proxy_ms, port)
        ms, tag = proxy.result()
        r = dict(gw=gw.result() if gw else None, direct=direct.result() if direct else None, proxy=ms, tag=tag)
    r["vpn"] = st == "Connected"
    r["state"] = classify(r["vpn"], r["gw"], r["direct"], r["proxy"], tag)
    return r


def log(**e):
    LOG.parent.mkdir(parents=True, exist_ok=True)
    if LOG.exists() and LOG.stat().st_size > 5_000_000:
        LOG.replace(LOG.with_suffix(".old"))
    with LOG.open("a") as f:
        f.write(json.dumps({"t": round(time.time()), **e}) + "\n")


def notify(text):
    script = 'display notification (item 1 of argv) with title "vpnguard"'
    run(["osascript", "-e", f"on run argv\n{script}\nend run", text], 5)


def restart_tunnel():
    sid, _ = service()
    if not sid:
        return False
    run(["scutil", "--nc", "stop", sid], 10)
    time.sleep(3)
    if service()[1] != "Connected":
        run(["scutil", "--nc", "start", sid], 10)
    for _ in range(20):
        time.sleep(1)
        if service()[1] == "Connected":
            return True
    return False


def start_tunnel():
    sid, st = service()
    if not sid or st == "Connected":
        return st == "Connected"
    run(["scutil", "--nc", "start", sid], 10)
    for _ in range(20):
        time.sleep(1)
        if service()[1] == "Connected":
            return True
    return False


def happ_config():
    try:
        return json.loads(CONF.read_text())
    except (OSError, ValueError):
        return None


def server_list(conf=None):
    """Серверы из конфига Happ: тег, адрес, порт, SNI. Конфиг Happ хранит зашифрованным, поэтому его импортируют."""
    rows = []
    for o in (conf or happ_config() or {}).get("outbounds", []):
        s = o.get("settings", {})
        peers = s.get("vnext") or s.get("servers") or []
        if not peers:
            continue
        st = o.get("streamSettings", {})
        tls = st.get("tlsSettings") or st.get("realitySettings") or {}
        rows.append(dict(tag=o.get("tag", "?"), host=peers[0].get("address"), port=int(peers[0].get("port", 443)),
                         sni=tls.get("serverName") or peers[0].get("address"), net=st.get("network", "tcp"),
                         sec=st.get("security", "none"), proto=o.get("protocol")))
    return rows


def doh(name, iface):
    """IPv4 адрес мимо туннеля: когда VPN сломан, его DNS тоже не отвечает."""
    if re.fullmatch(r"[\d.]+", name):
        return name
    for url in (f"https://1.1.1.1/dns-query?name={name}&type=A", f"https://8.8.8.8/resolve?name={name}&type=A"):
        out = run(["curl", "-s", "-m", "4", "--interface", iface, "-H", "accept: application/dns-json", url], 5)
        try:
            answer = json.loads(out.stdout).get("Answer", []) if out else []
        except ValueError:
            continue
        ips = [a["data"] for a in answer if a.get("type") == 1]
        if ips:
            return ips[0]
    return None


def probe_server(srv, iface):
    """TCP и TLS до сервера напрямую через Wi-Fi: так видно, режет ли его провайдер."""
    ip = doh(srv["host"], iface)
    if not ip:
        return dict(srv, ip=None, tcp=None, tls=None, err="DNS")
    tls_on = srv["sec"] in ("tls", "reality")
    scheme = "https" if tls_on else "http"
    cmd = ["curl", "-sk", "-o", "/dev/null", "-m", "6", "--interface", iface,
           "--connect-to", f"{srv['sni']}:{srv['port']}:{ip}:{srv['port']}",
           "-w", "%{time_connect} %{time_appconnect}", f"{scheme}://{srv['sni']}:{srv['port']}/"]
    out = run(cmd, 7)
    try:
        tcp, tls = (float(x) * 1000 for x in out.stdout.split())
    except (AttributeError, ValueError):
        tcp = tls = 0
    if not tls_on:
        tls = tcp
    err = None if tcp and tls else "TLS" if tcp else "TCP"
    return dict(srv, ip=ip, tcp=tcp or None, tls=tls or None, err=err)


def probe_servers():
    iface = route()[1]
    servers = server_list()
    if not iface or not servers:
        return []
    with cf.ThreadPoolExecutor(8) as ex:
        return list(ex.map(lambda s: probe_server(s, iface), servers))


CONN = re.compile(r"accepted (?:tcp|udp):(\[[^\]]+\]|[^\s:]+):\d+ \[\S+ (?:->|>>) ([\w-]+)\]")
ANSWER = re.compile(r"(?:got answer|cache HIT): (\S+?)\.? -> \[([^\]]*)\]")
IP_INFO = {}
IP_RE = re.compile(r"[\d.]+")


def txt(name, iface):
    out = run(["curl", "-s", "-m", "4", "--interface", iface, "-H", "accept: application/dns-json",
               f"https://1.1.1.1/dns-query?name={name}&type=TXT"], 5)
    try:
        return [a["data"].strip('"') for a in json.loads(out.stdout).get("Answer", [])] if out else []
    except ValueError:
        return []


def lookup_ip(ip, iface):
    """Страна и владелец сети по IP через DNS Team Cymru: имён в журнале нет, а страна видна всегда."""
    rev = ".".join(reversed(ip.split(".")))
    origin = txt(f"{rev}.origin.asn.cymru.com", iface)
    if not origin:
        return dict(cc=None, org=None)
    asn, _, cc = [x.strip() for x in origin[0].split("|")[:3]]
    org = (txt(f"AS{asn.split()[0]}.asn.cymru.com", iface) or ["||||"])[0].split("|")[-1].strip()
    org = re.sub(r",\s*[A-Z]{2}$", "", org)
    org = org.split(" - ", 1)[1] if " - " in org else org.split(" ", 1)[1] if " " in org else org
    return dict(cc=cc or None, org=org or f"AS{asn}")


def enrich(ips, limit=25):
    """Подтягивает сведения о новых IP в фоне; кэш на диске, чтобы не спрашивать повторно."""
    if not IP_INFO:
        try:
            IP_INFO.update(json.loads(IP_CACHE.read_text()))
        except (OSError, ValueError):
            pass
    todo = [ip for ip in ips if IP_RE.fullmatch(ip) and ip not in IP_INFO][:limit]
    iface = route()[1]
    if not todo or not iface:
        return
    with cf.ThreadPoolExecutor(8) as ex:
        IP_INFO.update(zip(todo, ex.map(lambda ip: lookup_ip(ip, iface), todo)))
    IP_CACHE.parent.mkdir(parents=True, exist_ok=True)
    IP_CACHE.write_text(json.dumps(IP_INFO))


def host_label(host):
    info = IP_INFO.get(host)
    return f"{info['org']} · {host}" if info and info["org"] else host


def is_ru_host(host):
    return is_ru(host) or (IP_INFO.get(host) or {}).get("cc") == "RU"


def is_ru(host):
    host = host.lower()
    return host.endswith((".ru", ".su", ".xn--p1ai", ".рф")) or any(k in host for k in RU_HINTS)


def access_stats(size=600_000, lookup=25):
    """Куда Happ отправляет трафик: доли маршрутов, хосты и российские сайты, ушедшие в VPN.

    Системный трафик попадает в журнал по IP, поэтому имена восстанавливаются из ответов DNS в том же журнале.
    """
    text = access_tail(size)
    names = {}
    for dom, ips in ANSWER.findall(text):
        for ip in ips.split(","):
            names[ip.strip()] = dom.rstrip(".")
    tags, hosts = collections.Counter(), collections.Counter()
    for host, tag in CONN.findall(text):
        if host in NOISE or tag == "dns-out":
            continue
        tags[tag] += 1
        hosts[(names.get(host, host), tag)] += 1
    if lookup:
        enrich([h for (h, _), _ in hosts.most_common(lookup * 2)], lookup)
    ru = collections.Counter()
    for (h, t), n in hosts.items():
        if t not in SERVICE_TAGS and is_ru_host(h):
            ru[host_label(h)] += n
    return dict(tags=tags, hosts=hosts, ru=ru)


def servers(st=None):
    """Какие серверы Happ реально использует: доля соединений в хвосте журнала."""
    tags = (st or access_stats())["tags"]
    used = {t: n for t, n in tags.items() if t not in SERVICE_TAGS}
    total = sum(used.values()) or 1
    return [(t, n / total) for t, n in sorted(used.items(), key=lambda kv: -kv[1])]


def route_check(port):
    """Открывает эталонные сайты через Happ и по журналу смотрит, каким маршрутом они ушли."""
    with cf.ThreadPoolExecutor(len(SITES)) as ex:
        res = list(ex.map(lambda s: via_proxy(port, f"https://{s[0]}/", 8), SITES))
    time.sleep(0.3)
    rows = []
    for (host, want), r in zip(SITES, res):
        tag = outbound_of(r[2], 200_000) if r else None
        works = bool(r and r[0] != "000")
        right = tag == "DIRECT" if want == "RU" else tag not in (None, "DIRECT", "BLOCK")
        rows.append(dict(host=host, want=want, tag=tag, works=works, ms=r[1] if r else None, right=right))
    return rows


def advice(state, probes, routes=None):
    """Человеческий вывод: что сломано и что сделать."""
    tips = []
    dead = [p["tag"] for p in probes if p["err"]]
    if state == "LOCAL":
        tips.append("Слабый Wi-Fi или роутер: подойди ближе, перезагрузи роутер. VPN тут ни при чём.")
    elif state == "ISP":
        tips.append("Роутер отвечает, но интернета нет: проблема у провайдера.")
    elif state == "VPN_DOWN":
        tips.append("Туннель выключен: включи Happ или запусти «vpn watch --keep-on».")
    if probes and len(dead) == len(probes):
        reasons = ", ".join(sorted({p["err"] for p in probes}))
        tips.append(f"Ни один сервер не отвечает из твоей сети ({reasons}): похоже на блокировку провайдером "
                    "или серверы лежат. Обнови подписку в Happ или выбери другую локацию.")
    elif dead:
        tips.append(f"Не отвечают: {', '.join(dead)}. Балансировщик Happ обходит их сам, но если тормозит, "
                    "выбери в Happ другой сервер.")
    if state in BROKEN and probes and not dead:
        tips.append("Серверы доступны, но трафик через туннель не идёт: перезапусти туннель (vpn restart), "
                    "если не поможет, обнови подписку в Happ.")
    if state == "LEAK":
        tips.append("Happ переключился на прямое соединение (fallback DIRECT): заблокированные сайты не "
                    "откроются, а сайты видят твой настоящий IP.")
    for r in routes or []:
        if r["want"] == "RU" and r["tag"] not in (None, "DIRECT"):
            tips.append(f"{r['host']} идёт через VPN ({r['tag']}): российские сайты могут не открываться "
                        "из-за зарубежного IP. В Happ включи маршрутизацию «RU напрямую».")
            break
    for r in routes or []:
        if r["want"] == "VPN" and r["tag"] == "DIRECT":
            tips.append(f"{r['host']} идёт напрямую, мимо VPN: проверь правила маршрутизации в Happ.")
            break
    return tips


def fmt(v):
    return "нет ответа" if v is None else f"{v:.0f} мс"


def cmd_status(a):
    r = sample(socks_port())
    print(f"Состояние:  {LABELS[r['state']]}")
    print(f"Роутер:     {fmt(r['gw'])}\nИнтернет:   {fmt(r['direct'])}")
    print(f"Туннель:    {'включён' if r['vpn'] else 'выключен'}\nЧерез VPN:  {fmt(r['proxy'])}")
    print(f"Сервер:     {r['tag'] or '?'}")
    return 0 if r["state"] == "OK" else 1


def summary(name, values):
    ok = [v for v in values if v is not None]
    loss = 100 * (len(values) - len(ok)) / max(len(values), 1)
    if not ok:
        print(f"{name:12} нет ответа")
        return loss, None
    p95 = sorted(ok)[max(int(len(ok) * .95) - 1, 0)]
    print(f"{name:12} медиана {statistics.median(ok):6.0f} мс   p95 {p95:6.0f} мс   макс {max(ok):6.0f} мс   потери {loss:.0f}%")
    return loss, p95


def print_servers(probes, shares):
    share = dict(shares)
    print(f"{'Сервер':10} {'Адрес':24} {'IP':16} {'TCP':>8} {'TLS':>8} {'Доля':>6}")
    for p in probes:
        mark = f"{RED}✗ {p['err']}{RESET}" if p["err"] else f"{GREEN}✓{RESET}"
        print(f"{p['tag']:10} {cut(p['host'], 24):24} {p['ip'] or '—':16} {short_ms(p['tcp']):>8} "
              f"{short_ms(p['tls']):>8} {share.get(p['tag'], 0) * 100:5.0f}%  {mark}")


def print_routes(rows):
    print(f"{'Сайт':20} {'Нужно':7} {'Маршрут':10} {'Ответ':>8}")
    for r in rows:
        want = "напрямую" if r["want"] == "RU" else "VPN"
        mark = f"{GREEN}✓{RESET}" if r["right"] and r["works"] else f"{YELLOW}не открылся{RESET}" if r["right"] \
            else f"{RED}✗ не тот маршрут{RESET}"
        print(f"{r['host']:20} {want:7} {r['tag'] or '?':10} {short_ms(r['ms']) if r['works'] else 'нет':>8}  {mark}")


def cmd_doctor(a):
    port, n = socks_port(), a.seconds
    gw_ip, iface = route()
    print(f"Замер {n} с, не закрывай ноутбук…")
    gw, direct, proxy, tags = [], [], [], []

    def series(fn, sink, step):
        end = time.time() + n
        while time.time() < end:
            start = time.time()
            sink.append(fn())
            time.sleep(max(step - (time.time() - start), 0))

    def probe():
        ms, tag = proxy_ms(port)
        tags.append(tag)
        return ms

    with cf.ThreadPoolExecutor(5) as ex:
        background = ex.submit(lambda: (probe_servers(), route_check(port)))
        list(ex.map(lambda t: series(*t), [
            (lambda: ping_once(gw_ip, iface), gw, 1),
            (lambda: ping_once(DIRECT_HOST, iface, 3), direct, 1),
            (probe, proxy, 3),
        ]))
        probes, routes = background.result()
    gl, gp = summary("Роутер", gw)
    summary("Интернет", direct)
    pl, pp = summary("Через VPN", proxy)
    here, there = location(["--interface", iface]), location(["-x", f"socks5h://127.0.0.1:{port}"])
    print(f"Выход:       прямой {here or '?'}, через VPN {there or '?'}")
    used = collections.Counter(t for t in tags if t)
    if used:
        print("Серверы:     " + ", ".join(f"{t} {c}" for t, c in used.most_common()))
    print()
    if gl > 2 or gp is None or gp > 200:
        state = "LOCAL"
        print("Вывод: проблема в Wi-Fi/роутере. Смена сервера и перезапуск VPN это не вылечат.")
    elif used.get("DIRECT"):
        state = "LEAK"
        print("Вывод: часть проверок ушла напрямую, мимо VPN: серверы Happ не отвечают.")
    elif pl > 10 or pp is None or pp > 2000:
        state = "VPN_BROKEN"
        print("Вывод: локальная сеть в порядке, виноваты VPN-серверы или маршрут до них.")
    else:
        state = "OK"
