def c256(n):
    return f"\033[38;5;{n}m"


GREEN, YELLOW, RED, DIM, RESET = "\033[32m", "\033[33m", "\033[31m", "\033[2m", "\033[0m"
CYAN, BOLD = "\033[36m", "\033[1m"
ANSI = re.compile(r"\033\[[0-9;?]*[A-Za-z]")
THRESHOLDS = dict(gw=100, direct=300, proxy=1500)
# Палитра в духе btop: градиент от зелёного к красному и свой цвет рамки у каждой панели
GRAD = [c256(n) for n in (35, 71, 107, 143, 179, 215, 209, 203, 197, 161)]
MUTED, TEXT = c256(244), c256(252)
FRAME = dict(main=c256(73), net=c256(141), srv=c256(179), route=c256(108), conn=c256(174))
STATE_COLOR = dict(OK=c256(78), LOCAL=c256(221), ISP=c256(221), VPN_BROKEN=c256(203), LEAK=c256(203),
                   VPN_DOWN=c256(203))


def visible(text):
    return len(ANSI.sub("", text))


def pad(text, width):
    return text + " " * max(width - visible(text), 0)


def cut(text, width):
    text = str(text)
    return text if len(text) <= width else text[:max(width - 1, 0)] + "…"


def box(title, rows, width, color=CYAN, height=None, hint=""):
    """Рамка как в btop: заголовок и подсказка врезаны в верхнюю линию."""
    inner = width - 4
    rows = list(rows)[:height - 2] if height else list(rows)
    if height:
        rows += [""] * (height - 2 - len(rows))
    head = f"{color}╭─┤{RESET}{BOLD}{TEXT}{title}{RESET}{color}├"
    tail = f"┤{RESET}{MUTED}{hint}{RESET}{color}├─╮{RESET}" if hint else f"─╮{RESET}"
    fill = width - visible(head) - visible(tail)
    top = head + "─" * max(fill, 0) + tail
    body = [f"{color}│{RESET} {pad(r, inner)} {color}│{RESET}" for r in rows]
    return [top, *body, f"{color}╰{'─' * (width - 2)}╯{RESET}"]


def beside(left, right):
    return [a + " " + b for a, b in zip(left, right)]


def center(text, width):
    left = max((width - visible(text)) // 2, 0)
    return pad(" " * left + text, width)


def fit(parts, width, sep="   "):
    out = ""
    for p in parts:
        cand = out + (sep if out else "") + p
        if visible(cand) > width:
            break
        out = cand
    return out


def grad(frac):
    return GRAD[min(max(int(frac * len(GRAD)), 0), len(GRAD) - 1)]


def graph(values, width, height, top=None, log_scale=False):
    """Площадной график Брайлем: два замера на клетку, заливка снизу, цвет по высоте.

    Без явного потолка шкала идёт по 95-му перцентилю: один пик не сплющивает весь график.
    """
    if width <= 0 or height <= 0:
        return []
    left_bits, right_bits = (0x40, 0x04, 0x02, 0x01), (0x80, 0x20, 0x10, 0x08)  # снизу вверх
    vals = list(values[-width * 2:])
    vals = [False] * (width * 2 - len(vals)) + vals  # False: истории ещё нет, None: сбой
    ok = [v for v in vals if v not in (None, False)]
    hi = top or (sorted(ok)[int(len(ok) * .95) - 1 if len(ok) > 1 else 0] * 1.3 if ok else 1) or 1
    lo = min(ok) * 0.85 if ok and log_scale else 1
    dots = height * 4

    def level(v):
        if v is None:
            return dots
        if v is False or v <= 0:
            return 0
        frac = math.log(max(v, lo) / lo) / math.log(max(hi / lo, 1.01)) if log_scale else v / hi
        return max(min(round(frac * dots), dots), 1)

    levels = [level(v) for v in vals]
    out = []
    for row in range(height):
        base = (height - 1 - row) * 4
        line = []
        for col in range(width):
            pair = levels[col * 2:col * 2 + 2]
            failed = vals[col * 2] is None or vals[col * 2 + 1] is None
            bits = 0
            for lv, table in zip(pair, (left_bits, right_bits)):
                for d in range(min(max(lv - base, 0), 4)):
                    bits |= table[d]
            if not bits:
                line.append(" ")
                continue
            color = c256(160) if failed else grad((base + 2) / dots)
            line.append(f"{color}{chr(0x2800 + bits)}")
        out.append("".join(line) + RESET)
    return out


def bar(frac, width, color=None):
    """Полоса из ■ как в btop: градиент по длине либо один цвет."""
    width = max(width, 1)
    n = round(min(max(frac, 0), 1) * width)
    filled = "".join(f"{color or grad(i / width)}■" for i in range(n))
    return f"{filled}{c256(238)}{'■' * (width - n)}{RESET}"


def short_ms(v):
    return "—" if v is None else f"{v / 1000:.1f} с" if v >= 1000 else f"{v:.0f} мс"


def loss_pct(values):
    return 100 * sum(v is None for v in values) / len(values) if values else 0


def jitter(values):
    ok = [v for v in values[-20:] if v is not None]
    return statistics.mean(abs(a - b) for a, b in zip(ok, ok[1:])) if len(ok) > 1 else None


def quality(states, values):
    """Оценка 0–100: доля исправных проверок минус штраф за нестабильную задержку."""
    if not states:
        return None
    recent = states[-40:]
    return max(round(100 * recent.count("OK") / len(recent) - min((jitter(values) or 0) / 20, 25)), 0)


def counters(iface):
    out = run(["netstat", "-ibn", "-I", iface], 5)
    for line in (out.stdout if out else "").splitlines():
        p = line.split()
        if len(p) >= 10 and p[0] == iface and p[2].startswith("<Link"):
            return int(p[-5]), int(p[-2])
    return None


def wifi_info():
    out = run(["system_profiler", "SPAirPortDataType"], 15)
    text = (out.stdout if out else "").partition("Current Network Information")[2]
    signal = re.search(r"Signal / Noise: (-\d+) dBm", text)
    channel = re.search(r"Channel: (\d+)", text)
    return dict(signal=int(signal.group(1)) if signal else None, channel=channel.group(1) if channel else None)


def paint_level(value, warn, bad):
    return c256(203) if value >= bad else c256(221) if value >= warn else c256(78)


def stats(hours=24):
    since = time.time() - hours * 3600
    states, fixes, speed = [], 0, None
    for path in (LOG.with_suffix(".old"), LOG):
        if not path.exists():
            continue
        for e in map(json.loads, path.read_text().splitlines()):
            if e.get("event") == "speed":
                speed = e
            if e["t"] < since:
                continue
            if "state" in e:
                states.append(e["state"])
            fixes += e.get("event") == "restart"
    return dict(states=collections.Counter(states), total=len(states), fixes=fixes, speed=speed)


