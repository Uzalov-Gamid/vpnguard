    else:
        rows.append(f"{MUTED}проверяю серверы…{RESET}")
    return box("Серверы", rows, w, FRAME["srv"], h, "напрямую, мимо VPN")


def panel_routes(s, w, h):
    st = s["access"]
    rows = []
    inner = w - 4
    if st:
        tags = st["tags"]
        total = sum(tags.values()) or 1
        vpn = total - tags["DIRECT"] - tags["BLOCK"]
        for name, n, color in (("Напрямую", tags["DIRECT"], c256(108)), ("Через VPN", vpn, c256(111)),
                               ("Блок", tags["BLOCK"], c256(167))):
            rows.append(f"{MUTED}{name:<10}{RESET}{bar(n / total, inner - 16, color)} {100 * n / total:3.0f}%")
        if st["ru"]:
            hosts = ", ".join(h for h, _ in st["ru"].most_common(4))
            rows.append(f"{c256(221)}RU через VPN:{RESET} {cut(hosts, inner - 14)}")
        else:
            rows.append(f"{c256(78)}✓{RESET} {MUTED}RU-сайты идут напрямую{RESET}")
    if s["routes_busy"]:
        rows.append(f"{c256(221)}проверяю маршруты…{RESET}")
    elif s["routes"]:
        cells = []
        for r in s["routes"]:
            ok = r["right"] and r["works"]
            mark = f"{c256(78)}✓" if ok else f"{c256(221)}!" if r["right"] else f"{c256(203)}✗"
            cells.append(f"{mark}{RESET} {cut(r['host'].removeprefix('www.'), 12):<12}")
        per = max(inner // 15, 1)
        rows += ["  ".join(cells[i:i + per]) for i in range(0, len(cells), per)]
    else:
        rows.append(f"{MUTED}[t] проверить RU напрямую / мир через VPN{RESET}")
    stt = s["stats"]
    if stt and stt["total"]:
        c, total = stt["states"], stt["total"]
        rows.append(f"{MUTED}24 ч:{RESET} норма {100 * c['OK'] / total:.1f}%  "
                    f"{MUTED}сбоев VPN{RESET} {100 * sum(c[k] for k in BROKEN) / total:.1f}%  "
                    f"{MUTED}перезапусков{RESET} {stt['fixes']}")
    return box("Маршруты", rows, w, FRAME["route"], h, "t тест")


def panel_conns(s, w, h):
    st = s["access"]
    inner = w - 4
    name_w = inner - 22
    rows = [f"{MUTED}{'кто':<{name_w}}{'стр':<4}{'маршрут':<10}{'соед.':>8}{RESET}"]
    if st:
        for (host, tag), n in st["hosts"].most_common(h - 3):
            warn = c256(221) if tag not in SERVICE_TAGS and is_ru_host(host) else ""
            cc = (IP_INFO.get(host) or {}).get("cc") or ""
            rows.append(f"{warn}{cut(host_label(host), name_w - 1):<{name_w}}{RESET}{MUTED}{cc:<4}{RESET}"
                        f"{tag_color(tag)}{cut(tag, 9):<10}{RESET}{n:>8}")
    return box("Соединения", rows, w, FRAME["conn"], h, "из журнала Happ")


def draw(s):
    cols, lines_max = shutil.get_terminal_size((100, 30))
    w = max(cols, 60)
    avail = lines_max - 1
    h_main = min(max(int(avail * 0.38), 9), 14)
    rest = avail - h_main
    lw = (w - 1) // 2
    rw = w - 1 - lw
    lines = panel_main(s, w, h_main)
    if rest >= 18:
        h1 = rest // 2
        h2 = rest - h1
        lines += beside(panel_net(s, lw, h1), panel_servers(s, rw, h1))
        lines += beside(panel_routes(s, lw, h2), panel_conns(s, rw, h2))
    elif rest >= 7:
        lines += beside(panel_net(s, lw, rest), panel_servers(s, rw, rest))
    keys = [("s", "скорость"), ("r", "перезапуск"), ("t", "маршруты"), ("d", "диагностика"), ("l", "отчёт"),
            ("q", "выход")]
    foot = "  ".join(f"{BOLD}{c256(215)}{k}{RESET} {MUTED}{t}{RESET}" for k, t in keys)
    if s["note"]:
        foot += f"   {c256(221)}{s['note']}{RESET}"
    lines.append(pad(" " + foot, w))
    lines = lines[:max(lines_max, 1)]
    sys.stdout.write("\033[H" + "\033[K\n".join(lines) + "\033[K\033[J")
    sys.stdout.flush()


def ui_state():
    return dict(r=None, hist=dict(gw=[], direct=[], proxy=[]), note="", busy=False, dirty=True, exit=None,
                stats=None, servers=[], watcher=False, speed=None, speed_busy=False, states=[], wifi=None,
                rate=None, net=([], []), iface=None, probes=[], access=None, routes=None, routes_busy=False,
                conf=happ_config())


def load_history(state):
    """Графики сразу показывают историю сторожа, а не пустое поле."""
    if not LOG.exists():
        return
    for e in map(json.loads, LOG.read_text().splitlines()[-300:]):
        if "state" in e:
            state["states"].append(e["state"])
            for key, values in state["hist"].items():
                values.append(e[key])
    for values in (*state["hist"].values(), state["states"]):
        del values[:-400]


def cmd_ui(a):
    if not sys.stdin.isatty() or not sys.stdout.isatty():
        return cmd_status(a)
    port, fd, saved = socks_port(), sys.stdin.fileno(), termios.tcgetattr(sys.stdin)
    state = ui_state()
    stop = threading.Event()
    load_history(state)

    def every(seconds, fn):
        def loop():
            while not stop.is_set():
                fn()
                state["dirty"] = True
                stop.wait(seconds)
        threading.Thread(target=loop, daemon=True).start()

    prev = [None]

    def traffic():
        iface, now = route()[1], time.time()
        state["iface"] = iface
        cur = counters(iface) if iface else None
        if prev[0] and cur:
            gap = now - prev[0][0]
            state["rate"] = ((cur[0] - prev[0][1][0]) * 8 / 1e6 / gap, (cur[1] - prev[0][1][1]) * 8 / 1e6 / gap)
            for values, v in zip(state["net"], state["rate"]):
                values.append(v)
                del values[:-400]
        prev[0] = (now, cur) if cur else None

    def slow():
        state.update(stats=stats(), watcher=watcher_alive(), wifi=wifi_info())
        iface = route()[1]
        state["exit"] = (location(["--interface", iface]) if iface else None,
                         location(["-x", f"socks5h://127.0.0.1:{port}"]))

    def journal():
        st = access_stats()
        state.update(access=st, servers=servers(st))

    def probe():
        state["probes"] = probe_servers()

    def tick():
        if state["busy"]:
            return
        r = sample(port)
        state["r"] = r
        for key, values in state["hist"].items():
            values.append(r[key])
            del values[:-400]
        state["states"].append(r["state"])
        del state["states"][:-400]

    def measure():
        state["speed"] = speed_test(port)
        state.update(speed_busy=False, stats=stats(), dirty=True)

    def check_routes():
        state.update(routes=route_check(port), routes_busy=False, dirty=True)

    def restart():
        state["note"], state["dirty"] = "Перезапускаю туннель…", True
        ok = restart_tunnel()
        state.update(note="Туннель перезапущен" if ok else "Не удалось перезапустить туннель", busy=False, dirty=True)

    def enter():
        tty.setcbreak(fd)
        sys.stdout.write("\033[?1049h\033[?25l\033[2J")

    def leave():
        sys.stdout.write("\033[?25h\033[?1049l")
        sys.stdout.flush()
        termios.tcsetattr(fd, termios.TCSADRAIN, saved)

    def pause(fn, args):
        leave()
        fn(args)
        input("\nEnter: вернуться к панели ")
        enter()
        state["dirty"] = True

    every(2, tick)
    every(1, traffic)
    every(3, journal)
    every(30, probe)
    every(60, slow)
    enter()
    size = None
    try:
        while True:
            if state["dirty"] or shutil.get_terminal_size() != size:
                state["dirty"], size = False, shutil.get_terminal_size()
                draw(state)
            if not select.select([sys.stdin], [], [], 0.2)[0]:
                continue
            key = os.read(fd, 2).decode(errors="ignore").lower()
            if key in ("q", "й", "\x1b"):
                break
            if key in ("s", "ы") and not state["speed_busy"]:
                state.update(speed_busy=True, dirty=True)
                threading.Thread(target=measure, daemon=True).start()
            elif key in ("t", "е") and not state["routes_busy"]:
                state.update(routes_busy=True, dirty=True)
                threading.Thread(target=check_routes, daemon=True).start()
            elif key in ("r", "к") and not state["busy"]:
                state["busy"] = True
                threading.Thread(target=restart, daemon=True).start()
            elif key in ("d", "в"):
                pause(cmd_doctor, argparse.Namespace(seconds=30))
            elif key in ("l", "д"):
                pause(cmd_report, argparse.Namespace(hours=24))
    except KeyboardInterrupt:
        pass
    finally:
        stop.set()
        leave()


def cmd_install(a):
    BIN.parent.mkdir(parents=True, exist_ok=True)
    if Path(__file__).resolve() != BIN.resolve():
        shutil.copy2(__file__, BIN)
    ALIAS.unlink(missing_ok=True)
    ALIAS.symlink_to(BIN)
    AGENT.parent.mkdir(parents=True, exist_ok=True)
    AGENT.write_bytes(plistlib.dumps({
        "Label": "com.vpnguard", "ProgramArguments": [sys.executable, "-I", str(BIN), "watch"],
        "RunAtLoad": True, "KeepAlive": True, "ThrottleInterval": 30,
        "StandardOutPath": str(HOME / "Library/Logs/vpnguard.out"),
        "StandardErrorPath": str(HOME / "Library/Logs/vpnguard.out"),
    }))
    uid = str(os.getuid())
    run(["launchctl", "bootout", f"gui/{uid}/com.vpnguard"], 10)
    for _ in range(10):  # bootout завершается асинхронно, сразу после него bootstrap падает
        out = run(["launchctl", "bootstrap", f"gui/{uid}", str(AGENT)], 10)
        if out and out.returncode == 0:
            break
        time.sleep(1)
    print("Установлено, сторож запущен" if out and out.returncode == 0 else f"Ошибка запуска: {out.stderr if out else 'timeout'}")


def cmd_uninstall(a):
    run(["launchctl", "bootout", f"gui/{os.getuid()}/com.vpnguard"], 10)
    AGENT.unlink(missing_ok=True)
    ALIAS.unlink(missing_ok=True)
    BIN.unlink(missing_ok=True)
    print("Сторож удалён. Журнал оставлен:", LOG)


class Plain:
    """Вывод в файл или пайп без цветовых кодов."""

    def __init__(self, stream):
        self.stream = stream

    def write(self, text):
        return self.stream.write(ANSI.sub("", text))

    def __getattr__(self, name):
        return getattr(self.stream, name)


def main():
    if not sys.stdout.isatty():
        sys.stdout = Plain(sys.stdout)
    p = argparse.ArgumentParser(prog="vpn", description="Сторож VPN для Happ. Без команды открывает живую панель")
    p.set_defaults(fn=cmd_ui)
    s = p.add_subparsers(dest="cmd")
    s.add_parser("status", help="мгновенная проверка всех уровней").set_defaults(fn=cmd_status)
    d = s.add_parser("doctor", help="замер, проверка серверов и маршрутов, советы")
    d.add_argument("seconds", nargs="?", type=int, default=30)
    d.set_defaults(fn=cmd_doctor)
    w = s.add_parser("watch", help="следить и чинить туннель")
    w.add_argument("--interval", type=int, default=10)
    w.add_argument("--fails", type=int, default=4, help="сбоев подряд до перезапуска")
    w.add_argument("--cooldown", type=int, default=180)
    w.add_argument("--max-per-hour", type=int, default=4)
    w.add_argument("--keep-on", action="store_true", help="включать туннель, если его выключили")
    w.add_argument("--dry-run", action="store_true")
    w.set_defaults(fn=cmd_watch)
    s.add_parser("speed", help="замер скорости через VPN и напрямую").set_defaults(fn=cmd_speed)
    s.add_parser("servers", help="доступность серверов мимо туннеля и их доля").set_defaults(fn=cmd_servers)
    s.add_parser("routes", help="RU-сайты напрямую, остальные через VPN?").set_defaults(fn=cmd_routes)
    c = s.add_parser("config", help="импорт JSON-конфига сервера из Happ (- читает stdin)")
    c.add_argument("file", nargs="?")
    c.set_defaults(fn=cmd_config)
    s.add_parser("restart", help="перезапустить туннель").set_defaults(fn=cmd_restart)
    r = s.add_parser("report", help="статистика из журнала")
    r.add_argument("hours", nargs="?", type=int, default=24)
    r.set_defaults(fn=cmd_report)
    s.add_parser("install", help="запускать сторож автоматически").set_defaults(fn=cmd_install)
    s.add_parser("uninstall", help="удалить сторож").set_defaults(fn=cmd_uninstall)
    a = p.parse_args()
    sys.exit(a.fn(a))


if __name__ == "__main__":
    main()
