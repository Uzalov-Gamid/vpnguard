def speed_once(path_args):
    """Скорость в Мбит/с. curl отдаёт результат и при таймауте: это честный замер за 10 с."""
    res = {}
    base = ["curl", "-s", "-o", "/dev/null", "-m", "10", *path_args]
    try:
        down = subprocess.run([*base, "-w", "%{speed_download}", SPEED_DOWN], capture_output=True, timeout=13)
        up = subprocess.run([*base, "-w", "%{speed_upload}", "--data-binary", "@-", SPEED_UP],
                            input=os.urandom(10_000_000), capture_output=True, timeout=13)
    except subprocess.TimeoutExpired:
        return dict(down=None, up=None)
    for key, r in (("down", down), ("up", up)):
        try:
            res[key] = round(float(r.stdout) * 8 / 1e6, 1) or None
        except ValueError:
            res[key] = None
    return res


def speed_test(port):
    vpn = speed_once(["-x", f"socks5h://127.0.0.1:{port}"])
    direct = speed_once(["--interface", route()[1] or "en0"])
    log(event="speed", vpn=vpn, direct=direct)
    return dict(t=time.time(), vpn=vpn, direct=direct)


