def cmd_watch(a):
    port, streak, down, last_restart, restarts, prev = socks_port(), 0, 0, 0.0, [], None
    tick = 0
    signal.signal(signal.SIGTERM, lambda *_: sys.exit(0))
    print(f"vpnguard следит, шаг {a.interval} с, журнал {LOG}", flush=True)
    while True:
        r = sample(port)
        tick += 1
        log(**r)
        if r["state"] != prev:
            print(time.strftime("%H:%M:%S"), LABELS[r["state"]], flush=True)
            if r["state"] == "LEAK":
                notify("Все серверы VPN недоступны, трафик идёт напрямую. Пробую починить.")
            prev = r["state"]
        streak = streak + 1 if r["state"] in BROKEN else 0
        down = down + 1 if r["state"] == "VPN_DOWN" else 0
        now = time.time()
        restarts = [t for t in restarts if now - t < 3600]
        if a.keep_on and down >= a.fails and not a.dry_run:
            done = start_tunnel()
            log(event="start", ok=done)
            notify("Туннель был выключен, включил обратно" if done else "Не удалось включить туннель")
            down = 0
        if streak >= a.fails and now - last_restart >= a.cooldown:
            if len(restarts) >= a.max_per_hour:
                tips = advice(r["state"], probe_servers())
                notify(tips[0] if tips else "VPN не работает, а лимит перезапусков исчерпан. Смени сервер в Happ.")
                log(event="limit")
                last_restart = now
            elif a.dry_run:
                print("dry-run: здесь был бы перезапуск", flush=True)
                last_restart = now
            else:
                done = restart_tunnel()
                time.sleep(5)
                after = sample(port)["state"] if done else r["state"]
                log(event="restart", ok=done and after == "OK")
                if after == "OK":
                    notify("Туннель перезапущен, VPN снова работает")
                else:
                    # перезапуск не помог: смотрим серверы мимо туннеля и говорим, что делать
                    tips = advice(after, probe_servers())
                    notify(tips[0] if tips else "Перезапуск не помог")
                restarts.append(now)
                last_restart, streak = now, 0
        if tick % 40 == 1 and r["state"] == "OK":
            here, there = location(["--interface", route()[1]]), location(["-x", f"socks5h://127.0.0.1:{port}"])
            leak = bool(here and here == there)
            log(event="exit", direct=here, vpn=there, leak=leak)
        if tick % 360 == 1:
            ru = access_stats()["ru"]
            if ru:
                log(event="ru_vpn", hosts=dict(ru.most_common(10)))
        time.sleep(a.interval)


