#!/opt/homebrew/bin/python3 -I
"""vpnguard: сторож для Happ на macOS.

Каждые несколько секунд проверяет связь по уровням: Wi-Fi/роутер, прямой
интернет, туннель, реальный трафик через прокси. Туннель перезапускается только
если сломан именно он, поэтому плохой Wi-Fi не вызывает лишних перезапусков.
"""
import argparse, collections, concurrent.futures as cf, json, math, os, plistlib, re, shutil, signal
import select, statistics, subprocess, sys, termios, threading, time, tty
from pathlib import Path

HOME = Path.home()
LOG = HOME / "Library/Logs/vpnguard.jsonl"
BIN = HOME / ".local/bin/vpnguard"
ALIAS = HOME / ".local/bin/vpn"
AGENT = HOME / "Library/LaunchAgents/com.vpnguard.plist"
HAPP_PREFS = HOME / "Library/Group Containers/group.su.ffg.happ.ruplus2/Library/Preferences/group.su.ffg.happ.ruplus2.plist"
ACCESS_LOG = HAPP_PREFS.parents[1] / "Application Support/Xray/logs/access.log"
SPEED_DOWN = "https://speed.cloudflare.com/__down?bytes=25000000"
SPEED_UP = "https://speed.cloudflare.com/__up"
PROBE_URL = "https://www.gstatic.com/generate_204"
TRACE_URL = "https://1.1.1.1/cdn-cgi/trace"
DIRECT_HOST = "77.88.8.8"
GW_SLOW_MS = 500

LABELS = {
    "OK": "всё работает",
    "LOCAL": "сбой Wi-Fi/роутера, VPN не виноват",
    "ISP": "роутер отвечает, но нет прямого интернета",
    "VPN_BROKEN": "сеть в порядке, но через VPN трафик не идёт",
    "VPN_DOWN": "туннель Happ выключен",
}
LABELS_SHORT = dict(OK="Норма", LOCAL="Wi-Fi", VPN_BROKEN="Сбой VPN")


def run(cmd, timeout):
    try:
        return subprocess.run(cmd, capture_output=True, text=True, timeout=timeout)
    except subprocess.TimeoutExpired:
        return None


def route():
    """Шлюз и интерфейс физической сети; default через utun пропускается."""
    out = run(["netstat", "-rn", "-f", "inet"], 5)
    for line in (out.stdout if out else "").splitlines():
        p = line.split()
        if len(p) >= 4 and p[0] == "default" and re.fullmatch(r"[\d.]+", p[1]):
            return p[1], p[3]
    return None, None


def ping_once(host, iface=None, timeout=2):
    cmd = ["ping", "-c", "1", "-t", str(timeout)] + (["-b", iface] if iface else []) + [host]
    out = run(cmd, timeout + 1)
    m = re.search(r"time=([\d.]+)", out.stdout) if out else None
    return float(m.group(1)) if m else None


def service():
    out = run(["scutil", "--nc", "list"], 5)
    for line in (out.stdout if out else "").splitlines():
        if "su.ffg.happ" in line:
            m = re.search(r"\(([^)]+)\)\s+([0-9A-F-]{36})", line)
            if m:
                return m.group(2), m.group(1)
    return None, None


def socks_port():
    try:
        return plistlib.loads(HAPP_PREFS.read_bytes()).get("sockstProxyPort") or "10808"
    except (OSError, plistlib.InvalidFileException):
        return "10808"


def proxy_ms(port, timeout=6):
    cmd = ["curl", "-s", "-o", "/dev/null", "-m", str(timeout), "-x", f"socks5h://127.0.0.1:{port}",
           "-w", "%{http_code} %{time_total}", PROBE_URL]
    out = run(cmd, timeout + 1)
    if not out or not out.stdout.startswith("204"):
        return None
    return float(out.stdout.split()[1]) * 1000


def location(args):
    out = run(["curl", "-s", "-m", "6", *args, TRACE_URL], 7)
    m = re.search(r"^loc=(\w+)", out.stdout, re.M) if out else None
    return m.group(1) if m else None


def classify(vpn_up, gw, direct, proxy):
    """Уровень сбоя; снизу вверх, потому что верхний уровень зависит от нижнего."""
    if gw is None or gw > GW_SLOW_MS:
        return "LOCAL"
    if direct is None:
        return "ISP"
    if not vpn_up:
        return "VPN_DOWN"
    return "OK" if proxy is not None else "VPN_BROKEN"


def sample(port):
    gw_ip, iface = route()
    sid, st = service()
    with cf.ThreadPoolExecutor(3) as ex:
        gw = ex.submit(ping_once, gw_ip, iface) if gw_ip else None
        direct = ex.submit(ping_once, DIRECT_HOST, iface, 3) if iface else None
        proxy = ex.submit(proxy_ms, port)
        r = dict(gw=gw.result() if gw else None, direct=direct.result() if direct else None, proxy=proxy.result())
    r["vpn"] = st == "Connected"
    r["state"] = classify(r["vpn"], r["gw"], r["direct"], r["proxy"])
    return r


def log(**e):
    LOG.parent.mkdir(parents=True, exist_ok=True)
    if LOG.exists() and LOG.stat().st_size > 5_000_000:
        LOG.replace(LOG.with_suffix(".old"))
    with LOG.open("a") as f:
        f.write(json.dumps({"t": round(time.time()), **e}) + "\n")


def notify(text):
    script = 'display notification (item 1 of argv) with title "vpnguard"'
    run(["osascript", "-e", f"on run argv\n{script}\nend run", text], 5)


def restart_tunnel():
    sid, _ = service()
    if not sid:
        return False
    run(["scutil", "--nc", "stop", sid], 10)
    time.sleep(3)
    if service()[1] != "Connected":
        run(["scutil", "--nc", "start", sid], 10)
    for _ in range(20):
        time.sleep(1)
        if service()[1] == "Connected":
            return True
    return False


def fmt(v):
    return "нет ответа" if v is None else f"{v:.0f} мс"


def cmd_status(a):
    r = sample(socks_port())
    print(f"Состояние:  {LABELS[r['state']]}")
    print(f"Роутер:     {fmt(r['gw'])}\nИнтернет:   {fmt(r['direct'])}")
    print(f"Туннель:    {'включён' if r['vpn'] else 'выключен'}\nЧерез VPN:  {fmt(r['proxy'])}")
    return 0 if r["state"] == "OK" else 1


def summary(name, values):
    ok = [v for v in values if v is not None]
    loss = 100 * (len(values) - len(ok)) / max(len(values), 1)
    if not ok:
        print(f"{name:12} нет ответа")
        return loss, None
    p95 = sorted(ok)[max(int(len(ok) * .95) - 1, 0)]
    print(f"{name:12} медиана {statistics.median(ok):6.0f} мс   p95 {p95:6.0f} мс   макс {max(ok):6.0f} мс   потери {loss:.0f}%")
    return loss, p95


def cmd_doctor(a):
    port, n = socks_port(), a.seconds
    gw_ip, iface = route()
    print(f"Замер {n} с, не закрывай ноутбук…")
    gw, direct, proxy = [], [], []

    def series(fn, sink, step):
        end = time.time() + n
        while time.time() < end:
            start = time.time()
            sink.append(fn())
            time.sleep(max(step - (time.time() - start), 0))

    with cf.ThreadPoolExecutor(3) as ex:
        list(ex.map(lambda t: series(*t), [
            (lambda: ping_once(gw_ip, iface), gw, 1),
            (lambda: ping_once(DIRECT_HOST, iface, 3), direct, 1),
            (lambda: proxy_ms(port), proxy, 3),
        ]))
    gl, gp = summary("Роутер", gw)
    summary("Интернет", direct)
    pl, pp = summary("Через VPN", proxy)
    here, there = location(["--interface", iface]), location(["-x", f"socks5h://127.0.0.1:{port}"])
    print(f"Выход:       прямой {here or '?'}, через VPN {there or '?'}")
    print()
    if gl > 2 or gp is None or gp > 200:
        print("Вывод: проблема в Wi-Fi/роутере. Смена сервера и перезапуск VPN это не вылечат.")
    elif pl > 10 or pp is None or pp > 2000:
        print("Вывод: локальная сеть в порядке, виноваты VPN-серверы или маршрут до них.")
    else:
        print("Вывод: все уровни в норме.")
    if here and here == there:
        print("Внимание: выход через VPN в той же стране, что и прямой. Возможен обход VPN (fallback в DIRECT).")


def cmd_watch(a):
    port, streak, last_restart, restarts, prev = socks_port(), 0, 0.0, [], None
    tick = 0
    signal.signal(signal.SIGTERM, lambda *_: sys.exit(0))
    print(f"vpnguard следит, шаг {a.interval} с, журнал {LOG}", flush=True)
    while True:
        r = sample(port)
        tick += 1
        log(**r)
        if r["state"] != prev:
            print(time.strftime("%H:%M:%S"), LABELS[r["state"]], flush=True)
            prev = r["state"]
        streak = streak + 1 if r["state"] == "VPN_BROKEN" else 0
        now = time.time()
        restarts = [t for t in restarts if now - t < 3600]
        if streak >= a.fails and now - last_restart >= a.cooldown:
            if len(restarts) >= a.max_per_hour:
                notify("VPN не работает, а лимит перезапусков исчерпан. Смени сервер в Happ.")
                log(event="limit")
                last_restart = now
            elif a.dry_run:
                print("dry-run: здесь был бы перезапуск", flush=True)
                last_restart = now
            else:
                done = restart_tunnel()
                log(event="restart", ok=done)
                notify("Туннель перезапущен" if done else "Не удалось перезапустить туннель")
                restarts.append(now)
                last_restart, streak = now, 0
        if tick % 40 == 1 and r["state"] == "OK":
            here, there = location(["--interface", route()[1]]), location(["-x", f"socks5h://127.0.0.1:{port}"])
            leak = bool(here and here == there)
            log(event="exit", direct=here, vpn=there, leak=leak)
        time.sleep(a.interval)


def cmd_restart(a):
    ok = restart_tunnel()
    print("Туннель перезапущен" if ok else "Не удалось перезапустить туннель")
    return 0 if ok else 1


def cmd_report(a):
    since = time.time() - a.hours * 3600
    rows = []
    if LOG.exists():
        rows = [e for e in map(json.loads, LOG.read_text().splitlines()) if e["t"] >= since]
    states = [e["state"] for e in rows if "state" in e]
    if not states:
        print("Данных пока нет: запусти vpnguard install или vpnguard watch.")
        return
    print(f"За {a.hours} ч, проверок: {len(states)}")
    for key, text in LABELS.items():
        c = states.count(key)
        if c:
            print(f"  {100 * c / len(states):5.1f}%  {text}")
    fixes = [e for e in rows if e.get("event") == "restart"]
    print(f"Перезапусков туннеля: {len(fixes)}, успешных: {sum(1 for e in fixes if e['ok'])}")
    leaks = sum(1 for e in rows if e.get("leak"))
    if leaks:
        print(f"Выход в своей стране замечен {leaks} раз: возможен обход VPN.")


GREEN, YELLOW, RED, DIM, RESET = "\033[32m", "\033[33m", "\033[31m", "\033[2m", "\033[0m"


CYAN, BOLD = "\033[36m", "\033[1m"
ANSI = re.compile(r"\033\[[0-9;?]*[A-Za-z]")
THRESHOLDS = dict(gw=100, direct=300, proxy=1500)


def visible(text):
    return len(ANSI.sub("", text))


def pad(text, width):
    return text + " " * max(width - visible(text), 0)


def box(title, rows, width):
    inner = width - 4
    top = f"{CYAN}╭─ {RESET}{BOLD}{title}{RESET}{CYAN} {'─' * max(width - visible(title) - 5, 0)}╮{RESET}"
    body = [f"{CYAN}│{RESET} {pad(r, inner)} {CYAN}│{RESET}" for r in rows]
    return [top, *body, f"{CYAN}╰{'─' * (width - 2)}╯{RESET}"]


def beside(left, right):
    height = max(len(left), len(right))
    lw, rw = visible(left[0]), visible(right[0])
    # Нижняя рамка короткой колонки опускается вровень с соседней
    def stretch(b, w):
        return b[:-1] + [pad(f"{CYAN}│{RESET}", w - 1) + f"{CYAN}│{RESET}"] * (height - len(b)) + b[-1:]
    return [a + " " + b for a, b in zip(stretch(left, lw), stretch(right, rw))]


def center(text, width):
    left = max((width - visible(text)) // 2, 0)
    return pad(" " * left + text, width)


def braille(values, width, height, slow):
    """Линейный график шрифтом Брайля: в одной клетке 2×4 точки, поэтому линия плавная."""
    dots = [[0x01, 0x08], [0x02, 0x10], [0x04, 0x20], [0x40, 0x80]]
    cells = [[0] * width for _ in range(height)]
    colors = [[GREEN] * width for _ in range(height)]
    values = values[-width * 2:]
    ok = [v for v in values if v is not None]
    if ok:  # логарифмическая шкала: иначе обычная задержка не видна рядом с пиками
        lo, hi = math.log(max(min(ok), 1)), math.log(max(max(ok), 1))
        hi = max(hi, lo + math.log(2))
        last = None
        top = height * 4 - 1
        for i, v in enumerate(values):
            x = width * 2 - len(values) + i
            if v is None:
                y, span, color = 0, [0], RED
            else:
                y = top - round((math.log(max(v, 1)) - lo) / (hi - lo) * top)
                span = range(min(y, last if last is not None else y), max(y, last if last is not None else y) + 1)
                color = YELLOW if v > slow else GREEN
                last = y
            for row in span:
                cells[row // 4][x // 2] |= dots[row % 4][x % 2]
                colors[row // 4][x // 2] = color
    return ["".join(f"{colors[r][c]}{chr(0x2800 + cells[r][c])}{RESET}" for c in range(width)) for r in range(height)]


def short_ms(v):
    return "—" if v is None else f"{v / 1000:.1f} с" if v >= 1000 else f"{v:.0f} мс"


def chart(title, values, width, slow):
    plot = width - 11
    ok = [v for v in values if v is not None]
    lines = braille(values, plot, 4, slow)
    hi, lo = (max(ok), min(ok)) if ok else (None, None)
    rows = [f"{DIM}{short_ms(hi):>6}┤{RESET}{lines[0]}", f"{DIM}{'':6}│{RESET}{lines[1]}",
            f"{DIM}{'':6}│{RESET}{lines[2]}", f"{DIM}{short_ms(lo):>6}┤{RESET}{lines[3]}"]
    avg = short_ms(statistics.mean(ok)) if ok else "—"
    now = short_ms(values[-1]) if values else "—"
    extra = f"  {DIM}потери{RESET} {loss_pct(values):.0f}%" if width >= 46 else ""
    rows.append(center(f"{DIM}сейчас{RESET} {now}  {DIM}среднее{RESET} {avg}{extra}", width - 4))
    return box(title, rows, width)


def loss_pct(values):
    return 100 * sum(v is None for v in values) / len(values) if values else 0


def jitter(values):
    ok = [v for v in values[-20:] if v is not None]
    return statistics.mean(abs(a - b) for a, b in zip(ok, ok[1:])) if len(ok) > 1 else None


def quality(states, values):
    """Оценка 0–100: доля исправных проверок минус штраф за нестабильную задержку."""
    if not states:
        return None
    recent = states[-40:]
    return max(round(100 * recent.count("OK") / len(recent) - min((jitter(values) or 0) / 20, 25)), 0)


def counters(iface):
    out = run(["netstat", "-ibn", "-I", iface], 5)
    for line in (out.stdout if out else "").splitlines():
        p = line.split()
        if len(p) >= 10 and p[0] == iface and p[2].startswith("<Link"):
            return int(p[-5]), int(p[-2])
    return None


def wifi_info():
    out = run(["system_profiler", "SPAirPortDataType"], 15)
    text = (out.stdout if out else "").partition("Current Network Information")[2]
    signal = re.search(r"Signal / Noise: (-\d+) dBm", text)
    channel = re.search(r"Channel: (\d+)", text)
    return dict(signal=int(signal.group(1)) if signal else None, channel=channel.group(1) if channel else None)


def tile(title, value, width, color=""):
    return box(title, [center(f"{BOLD}{color}{value}{RESET}", width - 4)], width)


def row_of(items, width):
    """Плитки в ряд; остаток ширины раздаётся слева, чтобы края совпали с другими рамками."""
    n = len(items)
    base, extra = (width - (n - 1)) // n, (width - (n - 1)) % n
    built = [tile(t, v, base + (i < extra), c) for i, (t, v, c) in enumerate(items)]
    line = built[0]
    for b in built[1:]:
        line = beside(line, b)
    return line


def paint_level(value, warn, bad):
    return RED if value >= bad else YELLOW if value >= warn else GREEN


def meter(share, width, color=GREEN):
    fill = round(share * width)
    return f"{color}{'▰' * fill}{RESET}{DIM}{'▱' * (width - fill)}{RESET}"


def servers():
    """Какие серверы Happ реально использует: доля соединений в хвосте журнала."""
    try:
        with ACCESS_LOG.open("rb") as f:
            f.seek(max(ACCESS_LOG.stat().st_size - 400_000, 0))
            text = f.read().decode(errors="ignore")
    except OSError:
        return []
    tags = collections.Counter(re.findall(r"-> ((?:proxy|wl|yt)[\w-]*)\]", text))
    total = sum(tags.values()) or 1
    return [(tag, n / total) for tag, n in tags.most_common()]


def stats(hours=24):
    since = time.time() - hours * 3600
    states, fixes, speed = [], 0, None
    for path in (LOG.with_suffix(".old"), LOG):
        if not path.exists():
            continue
        for e in map(json.loads, path.read_text().splitlines()):
            if e.get("event") == "speed":
                speed = e
            if e["t"] < since:
                continue
            if "state" in e:
                states.append(e["state"])
            fixes += e.get("event") == "restart"
    return dict(states=collections.Counter(states), total=len(states), fixes=fixes, speed=speed)


def watcher_alive():
    out = run(["launchctl", "print", f"gui/{os.getuid()}/com.vpnguard"], 5)
    return bool(out and out.returncode == 0)


def speed_once(path_args):
    """Скорость в Мбит/с. curl отдаёт результат и при таймауте: это честный замер за 10 с."""
    res = {}
    base = ["curl", "-s", "-o", "/dev/null", "-m", "10", *path_args]
    try:
        down = subprocess.run([*base, "-w", "%{speed_download}", SPEED_DOWN], capture_output=True, timeout=13)
        up = subprocess.run([*base, "-w", "%{speed_upload}", "--data-binary", "@-", SPEED_UP],
                            input=os.urandom(10_000_000), capture_output=True, timeout=13)
    except subprocess.TimeoutExpired:
        return dict(down=None, up=None)
    for key, r in (("down", down), ("up", up)):
        try:
            res[key] = round(float(r.stdout) * 8 / 1e6, 1) or None
        except ValueError:
            res[key] = None
    return res


def speed_test(port):
    with cf.ThreadPoolExecutor(1) as ex:
        vpn = ex.submit(speed_once, ["-x", f"socks5h://127.0.0.1:{port}"]).result()
    direct = speed_once(["--interface", route()[1] or "en0"])
    log(event="speed", vpn=vpn, direct=direct)
    return dict(t=time.time(), vpn=vpn, direct=direct)


def mbit(v):
    return f"{RED}нет{RESET}" if v is None else f"{v:.1f}"


def cmd_speed(a):
    print("Замер через VPN и напрямую, до минуты…")
    r = speed_test(socks_port())
    print(f"{'':12}{'Загрузка':>12}{'Отдача':>12}  Мбит/с")
    for name, key in (("Через VPN", "vpn"), ("Напрямую", "direct")):
        print(f"{name:12}{ANSI.sub('', mbit(r[key]['down'])):>12}{ANSI.sub('', mbit(r[key]['up'])):>12}")


def cmd_servers(a):
    rows = servers()
    if not rows:
        print("В журнале Happ нет данных о серверах.")
    for tag, share in rows:
        print(f"{tag:12} {'█' * round(share * 30):30} {share * 100:4.0f}%")


def draw(s):
    cols, lines_max = shutil.get_terminal_size((100, 30))
    w = min(max(cols - 2, 60), 100)
    r, hist = s["r"], s["hist"]
    label = LABELS[r["state"]] if r else "проверяю…"
    color = GREEN if r and r["state"] == "OK" else RED if r else DIM
    guard = f"{GREEN}активен{RESET}" if s["watcher"] else f"{RED}не запущен{RESET}"
    st = s["stats"]
    exits = s["exit"]
    route_text = f"{exits[0] or '?'} → {exits[1] or '?'}" if exits else "…"
    head = box("VPN", [center(f"{BOLD}{color}● {label}{RESET}", w - 4),
                       center(f"{DIM}Туннель{RESET} {GREEN + 'включён' if r and r['vpn'] else RED + 'выключен'}{RESET}"
                              f"    {DIM}Выход{RESET} {route_text}    {DIM}Сторож{RESET} {guard}", w - 4)], w)

    score, jit = quality(s["states"], hist["proxy"]), jitter(hist["proxy"])
    loss = loss_pct(hist["proxy"][-40:])
    wifi, rate = s["wifi"] or {}, s["rate"]
    signal = wifi.get("signal")
    tiles = [("Качество", f"{score}/100" if score is not None else "…", GREEN if score is None else
              paint_level(100 - score, 15, 40)),
             ("Джиттер", short_ms(jit), YELLOW if jit and jit > 150 else GREEN),
             ("Потери VPN", f"{loss:.0f}%", paint_level(loss, 2, 10)),
             ("Wi-Fi", f"{signal} дБм" if signal else "…", RED if signal and signal < -75 else GREEN),
             ("↓ Мбит/с", f"{rate[0]:.1f}" if rate else "…", CYAN),
             ("↑ Мбит/с", f"{rate[1]:.1f}" if rate else "…", CYAN)]
    tile_rows = row_of(tiles, w) if w >= 84 else row_of(tiles[:3], w) + row_of(tiles[3:], w)

    left = (w - 1) // 2
    right = w - 1 - left
    charts = beside(chart("Задержка через VPN", hist["proxy"], left, THRESHOLDS["proxy"]),
                    chart("Задержка до роутера", hist["gw"], right, THRESHOLDS["gw"]))
    sp = s["speed"] or (st["speed"] if st else None)
    if s["speed_busy"]:
        speed_rows = [f"{YELLOW}идёт замер…{RESET}"]
    elif sp:
        speed_rows = [f"{DIM}{'':10}{'↓ Мбит/с':>10}{'↑ Мбит/с':>10}{RESET}"]
        for name, key in (("VPN", "vpn"), ("Напрямую", "direct")):
            d, u = mbit(sp[key]["down"]), mbit(sp[key]["up"])
            speed_rows.append(f"{name:10}{' ' * (10 - visible(d))}{d}{' ' * (10 - visible(u))}{u}")
        speed_rows.append(f"{DIM}замер {time.strftime('%d.%m %H:%M', time.localtime(sp['t']))}{RESET}")
    else:
        speed_rows = [f"{DIM}нажми [s] для замера{RESET}"]
    if st and st["total"]:
        total, c = st["total"], st["states"]
        speed_panel_stats = [f"{pad(LABELS_SHORT[k], 10)} {meter(c[k] / total, right - 23, col)}  {100 * c[k] / total:5.1f}%"
                             for k, col in (("OK", GREEN), ("LOCAL", YELLOW), ("VPN_BROKEN", RED)) if k in c or k == "OK"]
        speed_panel_stats.append(f"{DIM}Автоперезапусков: {st['fixes']}{RESET}")
    else:
        speed_panel_stats = [f"{DIM}журнал пока пуст{RESET}"]
    middle = beside(box("Скорость", speed_rows, left), box("Доступность за 24 ч", speed_panel_stats, right))

    cell = (w - 4) // 2 - 2
    items = [f"{tag:10} {meter(share, cell - 17, CYAN)} {share * 100:3.0f}%" for tag, share in s["servers"][:6]]
    srv = [pad(a, cell + 2) + b for a, b in zip(items[::2], items[1::2] + [""])]
    bottom = box("Серверы Happ, доля соединений", srv or [center(f"{DIM}нет данных{RESET}", w - 4)], w)

    keys = center(f"{DIM}[s] скорость  [r] перезапуск  [d] диагностика  [l] отчёт  [q] выход{RESET}", w)
    tail = [keys, center(s["note"], w)]
    lines = list(head) + tile_rows
    for section in (charts, middle, bottom):  # на низком экране нижние панели скрываются, клавиши остаются
        if len(lines) + len(section) + len(tail) < lines_max:
            lines += section
    lines += tail
    lines = lines[:max(lines_max - 1, 1)]
    indent = " " * max((cols - w) // 2, 0)
    top = max((lines_max - len(lines)) // 2, 0)
    sys.stdout.write("\033[H" + "\033[K\n" * top + "\033[K\n".join(indent + l for l in lines) + "\033[K\033[J")
    sys.stdout.flush()


def cmd_ui(a):
    if not sys.stdin.isatty() or not sys.stdout.isatty():
        return cmd_status(a)
    port, fd, saved = socks_port(), sys.stdin.fileno(), termios.tcgetattr(sys.stdin)
    state = dict(r=None, hist=dict(gw=[], direct=[], proxy=[]), note="", busy=False, dirty=True, exit=None,
                 stats=None, servers=[], watcher=False, speed=None, speed_busy=False, states=[], wifi=None, rate=None)
    stop = threading.Event()
    if LOG.exists():  # графики сразу показывают историю сторожа, а не пустое поле
        for e in map(json.loads, LOG.read_text().splitlines()[-300:]):
            if "state" in e:
                state["states"].append(e["state"])
                for key, values in state["hist"].items():
                    values.append(e[key])
        for values in (*state["hist"].values(), state["states"]):
            del values[:-120]

    def traffic():
        prev = None
        while not stop.is_set():
            iface, now = route()[1], time.time()
            cur = counters(iface) if iface else None
            if prev and cur:
                gap = now - prev[0]
                state["rate"] = ((cur[0] - prev[1][0]) * 8 / 1e6 / gap, (cur[1] - prev[1][1]) * 8 / 1e6 / gap)
                state["dirty"] = True
            prev = (now, cur) if cur else None
            stop.wait(2)

    def slow_poller():
        while not stop.is_set():
            state.update(stats=stats(), servers=servers(), watcher=watcher_alive(), wifi=wifi_info(), dirty=True)
            iface = route()[1]
            state["exit"] = (location(["--interface", iface]) if iface else None,
                             location(["-x", f"socks5h://127.0.0.1:{port}"]))
            state["dirty"] = True
            stop.wait(60)

    def poller():
        while not stop.is_set():
            if not state["busy"]:
                r = sample(port)
                state["r"] = r
                for key, values in state["hist"].items():
                    values.append(r[key])
                    del values[:-120]
                state["states"].append(r["state"])
                del state["states"][:-120]
                state["dirty"] = True
            stop.wait(3)

    def measure():
        state["speed"] = speed_test(port)
        state.update(speed_busy=False, stats=stats(), dirty=True)

    def restart():
        state["note"], state["dirty"] = "Перезапускаю туннель…", True
        ok = restart_tunnel()
        state.update(note="Туннель перезапущен" if ok else "Не удалось перезапустить туннель", busy=False, dirty=True)

    def enter():
        tty.setcbreak(fd)
        sys.stdout.write("\033[?1049h\033[?25l\033[2J")

    def leave():
        sys.stdout.write("\033[?25h\033[?1049l")
        sys.stdout.flush()
        termios.tcsetattr(fd, termios.TCSADRAIN, saved)

    def pause(fn, args):
        leave()
        fn(args)
        input("\nEnter: вернуться к панели ")
        enter()
        state["dirty"] = True

    threading.Thread(target=poller, daemon=True).start()
    threading.Thread(target=slow_poller, daemon=True).start()
    threading.Thread(target=traffic, daemon=True).start()
    enter()
    size = None
    try:
        while True:
            if state["dirty"] or shutil.get_terminal_size() != size:
                state["dirty"], size = False, shutil.get_terminal_size()
                draw(state)
            if not select.select([sys.stdin], [], [], 0.2)[0]:
                continue
            key = os.read(fd, 2).decode(errors="ignore").lower()
            if key in ("q", "й", "\x1b"):
                break
            if key in ("s", "ы") and not state["speed_busy"]:
                state.update(speed_busy=True, dirty=True)
                threading.Thread(target=measure, daemon=True).start()
            if key in ("r", "к") and not state["busy"]:
                state["busy"] = True
                threading.Thread(target=restart, daemon=True).start()
            elif key in ("d", "в"):
                pause(cmd_doctor, argparse.Namespace(seconds=30))
            elif key in ("l", "д"):
                pause(cmd_report, argparse.Namespace(hours=24))
    except KeyboardInterrupt:
        pass
    finally:
        stop.set()
        leave()


def cmd_install(a):
    BIN.parent.mkdir(parents=True, exist_ok=True)
    if Path(__file__).resolve() != BIN.resolve():
        shutil.copy2(__file__, BIN)
    ALIAS.unlink(missing_ok=True)
    ALIAS.symlink_to(BIN)
    AGENT.parent.mkdir(parents=True, exist_ok=True)
    AGENT.write_bytes(plistlib.dumps({
        "Label": "com.vpnguard", "ProgramArguments": [sys.executable, "-I", str(BIN), "watch"],
        "RunAtLoad": True, "KeepAlive": True, "ThrottleInterval": 30,
        "StandardOutPath": str(HOME / "Library/Logs/vpnguard.out"),
        "StandardErrorPath": str(HOME / "Library/Logs/vpnguard.out"),
    }))
    uid = str(os.getuid())
    run(["launchctl", "bootout", f"gui/{uid}/com.vpnguard"], 10)
    for _ in range(10):  # bootout завершается асинхронно, сразу после него bootstrap падает
        out = run(["launchctl", "bootstrap", f"gui/{uid}", str(AGENT)], 10)
        if out and out.returncode == 0:
            break
        time.sleep(1)
    print("Установлено, сторож запущен" if out and out.returncode == 0 else f"Ошибка запуска: {out.stderr if out else 'timeout'}")


def cmd_uninstall(a):
    run(["launchctl", "bootout", f"gui/{os.getuid()}/com.vpnguard"], 10)
    AGENT.unlink(missing_ok=True)
    ALIAS.unlink(missing_ok=True)
    BIN.unlink(missing_ok=True)
    print("Сторож удалён. Журнал оставлен:", LOG)


def main():
    p = argparse.ArgumentParser(prog="vpn", description="Сторож VPN для Happ. Без команды открывает живую панель")
    p.set_defaults(fn=cmd_ui)
    s = p.add_subparsers(dest="cmd")
    s.add_parser("status", help="мгновенная проверка всех уровней").set_defaults(fn=cmd_status)
    d = s.add_parser("doctor", help="замер и вывод, где проблема")
    d.add_argument("seconds", nargs="?", type=int, default=30)
    d.set_defaults(fn=cmd_doctor)
    w = s.add_parser("watch", help="следить и чинить туннель")
    w.add_argument("--interval", type=int, default=10)
    w.add_argument("--fails", type=int, default=4, help="сбоев подряд до перезапуска")
    w.add_argument("--cooldown", type=int, default=180)
    w.add_argument("--max-per-hour", type=int, default=4)
    w.add_argument("--dry-run", action="store_true")
    w.set_defaults(fn=cmd_watch)
    s.add_parser("speed", help="замер скорости через VPN и напрямую").set_defaults(fn=cmd_speed)
    s.add_parser("servers", help="какие серверы использует Happ").set_defaults(fn=cmd_servers)
    s.add_parser("restart", help="перезапустить туннель").set_defaults(fn=cmd_restart)
    r = s.add_parser("report", help="статистика из журнала")
    r.add_argument("hours", nargs="?", type=int, default=24)
    r.set_defaults(fn=cmd_report)
    s.add_parser("install", help="запускать сторож автоматически").set_defaults(fn=cmd_install)
    s.add_parser("uninstall", help="удалить сторож").set_defaults(fn=cmd_uninstall)
    a = p.parse_args()
    sys.exit(a.fn(a))


if __name__ == "__main__":
    main()
